# Local development template. Copy to .env and fill in values.
# Same POSTGRES_* names are used for local Postgres and Heroku (CI maps GitHub Secrets).

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# dbt (run from ecommerce_transform/ or set this so profiles.yml is found)
DBT_PROFILES_DIR=./
THREADS=4
